<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_init_run</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Buat baris migration_run, set RUN_ID dan RUN_TS</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>MAIN_WORKFLOW</name>
        <default_value>wf_main.hwf</default_value>
        <description>Nama workflow utama</description>
      </parameter>
      <parameter>
        <name>CONFIG_ID</name>
        <default_value/>
        <description>ID atau daftar ID konfigurasi (wajib)</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/30 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/30 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Insert run</from>
      <to>Set RUN_ID</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Insert run</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>PG_TGT</connection><sql>WITH ins AS (
  INSERT INTO etl_antam.migration_run (run_ts, hop_host, main_workflow, config_id)
  VALUES (
    to_char(now() AT TIME ZONE 'Asia/Jakarta', 'YYYYMMDD_HH24MI'),
    COALESCE(inet_client_addr()::text, 'localhost'),
    CASE 
      WHEN '${MAIN_WORKFLOW}' NOT LIKE '\${%' AND '${MAIN_WORKFLOW}' &lt;&gt; '' THEN '${MAIN_WORKFLOW}'
      WHEN '${Internal.Workflow.Filename.Name}' NOT LIKE '\${%' AND '${Internal.Workflow.Filename.Name}' &lt;&gt; '' THEN '${Internal.Workflow.Filename.Name}'
      ELSE 'wf_main.hwf'
    END,
    NULLIF(regexp_replace(
      CASE 
        WHEN '${CONFIG_ID}' LIKE '$%' OR btrim('${CONFIG_ID}') = '' THEN NULL
        ELSE btrim('${CONFIG_ID}')
      END,
      '\s+', '', 'g'
    ), '')
  )
  RETURNING run_id, run_ts, COALESCE(config_id, '') AS config_id
)
SELECT run_id, run_ts, config_id FROM ins;</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Set RUN_ID</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields><field><field_name>run_id</field_name><variable_name>RUN_ID</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field><field><field_name>run_ts</field_name><variable_name>RUN_TS</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field><field><field_name>config_id</field_name><variable_name>CONFIG_ID</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field></fields><use_formatting>N</use_formatting>
    <attributes/>
    <GUI>
      <xloc>350</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
</pipeline>
