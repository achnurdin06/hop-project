<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_purge_target</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Hapus data target hasil migrasi (single/multiple ID atau all data)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>CONFIG_ID</name>
        <default_value>1</default_value>
        <description>Config ID</description>
      </parameter>
      <parameter>
        <name>DELETE_IDS</name>
        <default_value/>
        <description>Single/Multiple ID dipisah koma</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
  </order>
  <transform>
    <name>Purge target data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>PG_TGT</connection><sql>WITH exec AS (
  SELECT etl_antam.fn_purge_target_data(${RUN_ID}, ${CONFIG_ID}, NULLIF('${DELETE_IDS}', '')) AS res
)
SELECT res FROM exec WHERE res = 0;</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
</pipeline>
