<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_delta</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Hitung delta staging vs target lewat etl_antam.fn_calc_delta</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/30 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/30 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Delta</from>
      <to>Set D_ vars</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Delta</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>PG_TGT</connection><sql>SELECT o_status, o_new, o_chg, o_del, o_changes
FROM etl_antam.fn_calc_delta(${RUN_ID}, ${CONFIG_ID})</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Set D_ vars</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields><field><field_name>o_status</field_name><variable_name>DELTA_STATUS</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field><field><field_name>o_new</field_name><variable_name>D_NEW</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field><field><field_name>o_chg</field_name><variable_name>D_CHG</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field><field><field_name>o_del</field_name><variable_name>D_DEL</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field><field><field_name>o_changes</field_name><variable_name>D_CHANGES</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field></fields><use_formatting>N</use_formatting>
    <attributes/>
    <GUI>
      <xloc>350</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
</pipeline>
