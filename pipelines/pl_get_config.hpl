<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_get_config</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Baca config aktif, kirim sebagai result rows</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>TARGET_RUN_ID</name>
        <default_value/>
        <description>Target Run ID sesi migrasi yang akan di-rollback</description>
      </parameter>
      <parameter>
        <name>RUN_ID</name>
        <default_value/>
        <description>Target Run ID sesi migrasi untuk filter config_id</description>
      </parameter>
      <parameter>
        <name>CONFIG_ID</name>
        <default_value/>
        <description>ID atau daftar ID konfigurasi yang akan diproses</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/30 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/30 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read config</from>
      <to>Copy rows to result</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read config</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>PG_TGT</connection><sql>SELECT config_id, exec_order, src_schema, src_view, tgt_schema, tgt_table,
       stg_table, src_precheck_sql
FROM etl_antam.migration_config
WHERE is_active
  AND (
    CASE 
      WHEN '${TARGET_RUN_ID}' NOT LIKE '$%' AND btrim('${TARGET_RUN_ID}') != '' THEN
        config_id = ANY (
          string_to_array(
            (SELECT regexp_replace(COALESCE(config_id, ''), '\s+', '', 'g')
             FROM etl_antam.migration_run
             WHERE run_id = NULLIF(btrim('${TARGET_RUN_ID}'), '')::bigint),
            ','
          )::int[]
        )
      WHEN '${RUN_ID}' NOT LIKE '$%' AND btrim('${RUN_ID}') != ''
           AND EXISTS (
             SELECT 1 FROM etl_antam.migration_run 
             WHERE run_id = NULLIF(btrim('${RUN_ID}'), '')::bigint 
               AND config_id IS NOT NULL AND btrim(config_id) != ''
           ) THEN
        config_id = ANY (
          string_to_array(
            (SELECT regexp_replace(COALESCE(config_id, ''), '\s+', '', 'g')
             FROM etl_antam.migration_run
             WHERE run_id = NULLIF(btrim('${RUN_ID}'), '')::bigint),
            ','
          )::int[]
        )
      WHEN '${CONFIG_ID}' NOT LIKE '$%' AND btrim('${CONFIG_ID}') != '' THEN
        config_id = ANY (
          string_to_array(regexp_replace('${CONFIG_ID}', '\s+', '', 'g'), ',')::int[]
        )
      ELSE true
    END
  )
ORDER BY exec_order, config_id</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Copy rows to result</name>
    <type>RowsToResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields/>
    <attributes/>
    <GUI>
      <xloc>350</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
</pipeline>
