<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_register_client_env</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Registrasi dan Sinkronisasi Master Client dan Master Environment ke Database</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>CLIENT_CODE</name>
        <default_value>${CLIENT_CODE}</default_value>
        <description>Kode Klien Master (contoh: ANTAM)</description>
      </parameter>
      <parameter>
        <name>CLIENT_NAME</name>
        <default_value>${CLIENT_NAME}</default_value>
        <description>Nama Resmi Klien (contoh: PT ANTAM Tbk)</description>
      </parameter>
      <parameter>
        <name>CLIENT_DESC</name>
        <default_value>${CLIENT_DESC}</default_value>
        <description>Deskripsi Klien</description>
      </parameter>
      <parameter>
        <name>ENV_CODE</name>
        <default_value>${ENV_CODE}</default_value>
        <description>Kode Environment Master (contoh: DEV)</description>
      </parameter>
      <parameter>
        <name>ENV_NAME</name>
        <default_value>${ENV_NAME}</default_value>
        <description>Nama Environment Master (contoh: Development)</description>
      </parameter>
      <parameter>
        <name>ENV_DESC</name>
        <default_value>${ENV_DESC}</default_value>
        <description>Deskripsi Environment</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/10 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/10 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Upsert Master Client and Env</from>
      <to>Set Master Variables</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Upsert Master Client and Env</name>
    <type>TableInput</type>
    <description>Sinkronisasi data master client dan environment ke PostgreSQL</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>PG_TGT</connection><sql>WITH upsert_client AS (
  INSERT INTO etl_antam.master_client (client_code, client_name, description, is_active)
  VALUES (
    UPPER(TRIM(COALESCE(NULLIF(CASE WHEN '${CLIENT_CODE}' LIKE '$%' THEN '' ELSE '${CLIENT_CODE}' END, ''), 'ANTAM'))),
    TRIM(COALESCE(NULLIF(CASE WHEN '${CLIENT_NAME}' LIKE '$%' THEN '' ELSE '${CLIENT_NAME}' END, ''), 'PT ANTAM Tbk')),
    NULLIF(TRIM(CASE WHEN '${CLIENT_DESC}' LIKE '$%' THEN '' ELSE '${CLIENT_DESC}' END), ''),
    true
  )
  ON CONFLICT (client_code) DO UPDATE
  SET client_name = EXCLUDED.client_name,
      description = COALESCE(EXCLUDED.description, master_client.description),
      updated_at  = CURRENT_TIMESTAMP
  RETURNING client_id, client_code, client_name
),
active_client AS (
  SELECT client_id, client_code, client_name FROM upsert_client
  UNION ALL
  SELECT client_id, client_code, client_name FROM etl_antam.master_client
  WHERE client_code = UPPER(TRIM(COALESCE(NULLIF(CASE WHEN '${CLIENT_CODE}' LIKE '$%' THEN '' ELSE '${CLIENT_CODE}' END, ''), 'ANTAM')))
  LIMIT 1
),
upd_env AS (
  UPDATE etl_antam.master_environment e
  SET env_name   = TRIM(COALESCE(NULLIF(CASE WHEN '${ENV_NAME}' LIKE '$%' THEN '' ELSE '${ENV_NAME}' END, ''), 'Development')),
      description= COALESCE(NULLIF(TRIM(CASE WHEN '${ENV_DESC}' LIKE '$%' THEN '' ELSE '${ENV_DESC}' END), ''), e.description),
      updated_at = CURRENT_TIMESTAMP
  FROM active_client c
  WHERE e.client_id = c.client_id 
    AND e.env_code = UPPER(TRIM(COALESCE(NULLIF(CASE WHEN '${ENV_CODE}' LIKE '$%' THEN '' ELSE '${ENV_CODE}' END), ''), 'DEV')))
  RETURNING e.env_id, e.client_id, e.env_code, e.env_name
),
ins_env AS (
  INSERT INTO etl_antam.master_environment (client_id, env_code, env_name, description, is_active)
  SELECT 
    c.client_id, 
    UPPER(TRIM(COALESCE(NULLIF(CASE WHEN '${ENV_CODE}' LIKE '$%' THEN '' ELSE '${ENV_CODE}' END), ''), 'DEV'))), 
    TRIM(COALESCE(NULLIF(CASE WHEN '${ENV_NAME}' LIKE '$%' THEN '' ELSE '${ENV_NAME}' END), ''), 'Development')), 
    NULLIF(TRIM(CASE WHEN '${ENV_DESC}' LIKE '$%' THEN '' ELSE '${ENV_DESC}' END), ''), 
    true
  FROM active_client c
  WHERE NOT EXISTS (
    SELECT 1 FROM etl_antam.master_environment e 
    WHERE e.client_id = c.client_id 
      AND e.env_code = UPPER(TRIM(COALESCE(NULLIF(CASE WHEN '${ENV_CODE}' LIKE '$%' THEN '' ELSE '${ENV_CODE}' END), ''), 'DEV')))
  )
  RETURNING env_id, client_id, env_code, env_name
),
active_env AS (
  SELECT env_id, client_id, env_code, env_name FROM upd_env
  UNION ALL
  SELECT env_id, client_id, env_code, env_name FROM ins_env
  UNION ALL
  SELECT e.env_id, e.client_id, e.env_code, e.env_name
  FROM etl_antam.master_environment e
  JOIN active_client c ON e.client_id = c.client_id
  WHERE e.env_code = UPPER(TRIM(COALESCE(NULLIF(CASE WHEN '${ENV_CODE}' LIKE '$%' THEN '' ELSE '${ENV_CODE}' END), ''), 'DEV')))
  LIMIT 1
)
SELECT 
  c.client_id, c.client_code, c.client_name,
  e.env_id, e.env_code, e.env_name,
  'SUCCESS' AS register_status
FROM active_client c
CROSS JOIN active_env e
LIMIT 1;</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>120</xloc>
      <yloc>120</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Set Master Variables</name>
    <type>SetVariable</type>
    <description>Simpan identitas terdaftar ke variabel runtime workflow</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field><field_name>client_id</field_name><variable_name>CLIENT_ID</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>client_code</field_name><variable_name>CLIENT_CODE</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>client_name</field_name><variable_name>CLIENT_NAME</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>env_id</field_name><variable_name>ENV_ID</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>env_code</field_name><variable_name>ENV_CODE</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>env_name</field_name><variable_name>ENV_NAME</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>register_status</field_name><variable_name>REGISTER_STATUS</variable_name><variable_type>ROOT_WORKFLOW</variable_type><default_value/></field>
    </fields><use_formatting>N</use_formatting>
    <attributes/>
    <GUI>
      <xloc>380</xloc>
      <yloc>120</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
</pipeline>
