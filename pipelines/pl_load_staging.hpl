<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>SRC_SCHEMA</name>
        <default_value>dbo</default_value>
        <description>Source Schema</description>
      </parameter>
      <parameter>
        <name>SRC_VIEW</name>
        <default_value>v_migration_vendor</default_value>
        <description>Source View</description>
      </parameter>
      <parameter>
        <name>STG_TABLE</name>
        <default_value>stg_vendors</default_value>
        <description>Staging Table</description>
      </parameter>
      <parameter>
        <name>RUN_ID</name>
        <default_value>0</default_value>
        <description>Run ID</description>
      </parameter>
      <parameter>
        <name>CONFIG_ID</name>
        <default_value>0</default_value>
        <description>Config ID</description>
      </parameter>
    </parameters>
    <name>pl_load_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load view SQL Server ke tabel pendarat stg_antam.&lt;STG_TABLE>_src; baris ditolak masuk migration_error_log</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/30 10:00:00.000</created_date>
    <modified_date>2026/09/30 10:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read source view</name>
    <sql>SELECT * FROM [${SRC_SCHEMA}].[${SRC_VIEW}]</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>MSSQL_SRC</connection>
    <lookup/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Table output stg</name>
    <connection>PG_TGT</connection>
    <schema>stg_antam</schema>
    <table>${STG_TABLE}</table>
    <commit>5000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>336</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ConcatFields</type>
    <name>Concat row data</name>
    <separator>|</separator>
    <enclosure/>
    <force_enclosure>N</force_enclosure>
    <fields/>
    <ConcatFields>
      <targetFieldLength>0</targetFieldLength>
      <removeSelectedFields>N</removeSelectedFields>
    </ConcatFields>
    <skip_value_empty>N</skip_value_empty>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>350</xloc>
      <yloc>260</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Get run ids</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${RUN_ID}</variable>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>config_id</name>
        <variable>${CONFIG_ID}</variable>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>550</xloc>
      <yloc>260</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>Add constants</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>STAGING</nullif>
        <name>step_name</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>pl_load_staging</nullif>
        <name>pipeline_name</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>Table output stg</nullif>
        <name>transform_name</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>750</xloc>
      <yloc>260</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Table output error log</name>
    <connection>PG_TGT</connection>
    <schema>etl_antam</schema>
    <table>migration_error_log</table>
    <commit>100</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>N</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>run_id</stream_name>
        <column_name>run_id</column_name>
      </field>
      <field>
        <stream_name>config_id</stream_name>
        <column_name>config_id</column_name>
      </field>
      <field>
        <stream_name>step_name</stream_name>
        <column_name>step_name</column_name>
      </field>
      <field>
        <stream_name>pipeline_name</stream_name>
        <column_name>pipeline_name</column_name>
      </field>
      <field>
        <stream_name>transform_name</stream_name>
        <column_name>transform_name</column_name>
      </field>
      <field>
        <stream_name>error_code</stream_name>
        <column_name>error_code</column_name>
      </field>
      <field>
        <stream_name>error_description</stream_name>
        <column_name>error_message</column_name>
      </field>
      <field>
        <stream_name>error_fields</stream_name>
        <column_name>error_field</column_name>
      </field>
      <field>
        <stream_name>row_data</stream_name>
        <column_name>row_data</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>950</xloc>
      <yloc>260</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Select values</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>uuid</name>
        <rename>uuid</rename>
        <type>UUID</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask/>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
        <roundingType>half_even</roundingType>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>208</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Table output stg</from>
      <to>Concat row data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Concat row data</from>
      <to>Get run ids</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get run ids</from>
      <to>Add constants</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add constants</from>
      <to>Table output error log</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read source view</from>
      <to>Select values</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select values</from>
      <to>Table output stg</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling>
    <error>
      <source_transform>Table output stg</source_transform>
      <target_transform>Concat row data</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>nr_errors</nr_valuename>
      <descriptions_valuename>error_description</descriptions_valuename>
      <fields_valuename>error_fields</fields_valuename>
      <codes_valuename>error_code</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
</pipeline>
