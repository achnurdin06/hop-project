<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>wf_purge_target_tables</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Hapus data target hasil migrasi berbasis migration_target_config (single/multiple ID atau all data)</description>
  <extended_description />
  <created_user>-</created_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <workflow_version />
  <parameters>
    <parameter>
      <name>CONFIG_ID</name>
      <description />
      <default_value />
    </parameter>
    <parameter>
      <name>DELETE_IDS</name>
      <description />
      <default_value />
    </parameter>
  </parameters>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <xloc>100</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac />
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_purge_target.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile />
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>CONFIG_ID</name>
          <stream_name />
          <value>${CONFIG_ID}</value>
          <variable>${CONFIG_ID}</variable>
        </parameter>
        <parameter>
          <name>DELETE_IDS</name>
          <stream_name />
          <value>${DELETE_IDS}</value>
          <variable>${DELETE_IDS}</variable>
        </parameter>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Purge target pipeline</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <xloc>350</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac />
    </action>
    <action>
      <sql>CALL etl_antam.pr_fail(${RUN_ID}, ${CONFIG_ID}, 'PURGE_TARGET', 'WORKFLOW_FAILED', 'wf_purge_target_tables gagal. Cek log Hop dan migration_error_log')</sql>
      <connection>PG_TGT</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename />
      <sendOneStatement>N</sendOneStatement>
      <name>Fail purge target</name>
      <description />
      <type>SQL</type>
      <attributes />
      <xloc>350</xloc>
      <yloc>260</yloc>
      <parallel>N</parallel>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Purge target pipeline</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Purge target pipeline</from>
      <to>Fail purge target</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>
