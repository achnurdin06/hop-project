<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_register_client_env</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Workflow Registrasi dan Sinkronisasi Master Client dan Master Environment dari Apache Hop ke Database</description>
  <extended_description/>
  <created_user>-</created_user>
  <created_date>2026/10/10 09:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/10 09:00:00.000</modified_date>
  <workflow_version/>
  <parameters>
    <parameter>
      <name>CLIENT_CODE</name>
      <description>Kode Klien Master (contoh: ANTAM)</description>
      <default_value>${CLIENT_CODE}</default_value>
    </parameter>
    <parameter>
      <name>CLIENT_NAME</name>
      <description>Nama Resmi Klien (contoh: PT ANTAM Tbk)</description>
      <default_value>${CLIENT_NAME}</default_value>
    </parameter>
    <parameter>
      <name>CLIENT_DESC</name>
      <description>Deskripsi Klien</description>
      <default_value>${CLIENT_DESC}</default_value>
    </parameter>
    <parameter>
      <name>ENV_CODE</name>
      <description>Kode Environment Master (contoh: DEV)</description>
      <default_value>${ENV_CODE}</default_value>
    </parameter>
    <parameter>
      <name>ENV_NAME</name>
      <description>Nama Environment Master (contoh: Development)</description>
      <default_value>${ENV_NAME}</default_value>
    </parameter>
    <parameter>
      <name>ENV_DESC</name>
      <description>Deskripsi Environment</description>
      <default_value>${ENV_DESC}</default_value>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Register Master</name>
      <description>Jalankan pipeline pendaftaran master client &amp; environment</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/pl_register_client_env.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>CLIENT_CODE</name>
          <stream_name/>
          <value>${CLIENT_CODE}</value>
          <variable>${CLIENT_CODE}</variable>
        </parameter>
        <parameter>
          <name>CLIENT_NAME</name>
          <stream_name/>
          <value>${CLIENT_NAME}</value>
          <variable>${CLIENT_NAME}</variable>
        </parameter>
        <parameter>
          <name>CLIENT_DESC</name>
          <stream_name/>
          <value>${CLIENT_DESC}</value>
          <variable>${CLIENT_DESC}</variable>
        </parameter>
        <parameter>
          <name>ENV_CODE</name>
          <stream_name/>
          <value>${ENV_CODE}</value>
          <variable>${ENV_CODE}</variable>
        </parameter>
        <parameter>
          <name>ENV_NAME</name>
          <stream_name/>
          <value>${ENV_NAME}</value>
          <variable>${ENV_NAME}</variable>
        </parameter>
        <parameter>
          <name>ENV_DESC</name>
          <stream_name/>
          <value>${ENV_DESC}</value>
          <variable>${ENV_DESC}</variable>
        </parameter>
      </parameters>
      <run_configuration>local</run_configuration>
      <parallel>N</parallel>
      <xloc>320</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Register Master</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Register Master</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>
