<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>wf_main</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orkestrator: cek koneksi/tabel, init run, loop config, finish run</description>
  <extended_description />
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/09/30 10:00:00.000</created_date>
  <modified_date>2026/09/30 10:00:00.000</modified_date>
  <workflow_version />
  <parameters>
    <parameter>
      <name>CONFIG_ID</name>
      <description>ID konfigurasi yang akan diproses (Wajib, bisa satu atau beberapa dipisah koma, contoh: 1 atau 1,2,3)</description>
      <default_value/>
    </parameter>
    <parameter>
      <name>CLIENT_CODE</name>
      <description>Kode Klien Master (default: ${CLIENT_CODE})</description>
      <default_value>${CLIENT_CODE}</default_value>
    </parameter>
    <parameter>
      <name>ENV_CODE</name>
      <description>Kode Environment Master (default: ${ENV_CODE})</description>
      <default_value>${ENV_CODE}</default_value>
    </parameter>
  </parameters>
  <actions>
      <action>
         <repeat>N</repeat>
         <schedulerType>0</schedulerType>
         <intervalSeconds>0</intervalSeconds>
         <intervalMinutes>60</intervalMinutes>
         <DayOfMonth>1</DayOfMonth>
         <weekDay>1</weekDay>
         <minutes>0</minutes>
         <hour>12</hour>
         <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
         <name>Start</name>
         <description />
         <type>SPECIAL</type>
         <attributes />
         <xloc>48</xloc>
         <yloc>48</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <connections>
            <connection>
               <name>MSSQL_SRC</name>
               <waitfor>0</waitfor>
               <waittime>millisecond</waittime>
            </connection>
            <connection>
               <name>PG_TGT</name>
               <waitfor>0</waitfor>
               <waittime>millisecond</waittime>
            </connection>
         </connections>
         <name>Check DB connections</name>
         <description />
         <type>CHECK_DB_CONNECTIONS</type>
         <attributes />
         <xloc>250</xloc>
         <yloc>60</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <tablename>migration_config</tablename>
         <schemaname>etl_antam</schemaname>
         <connection>PG_TGT</connection>
         <name>Exists migration_config</name>
         <description />
         <type>TABLE_EXISTS</type>
         <attributes />
         <xloc>448</xloc>
         <yloc>48</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <tablename>migration_run</tablename>
         <schemaname>etl_antam</schemaname>
         <connection>PG_TGT</connection>
         <name>Exists migration_run</name>
         <description />
         <type>TABLE_EXISTS</type>
         <attributes />
         <xloc>650</xloc>
         <yloc>60</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <tablename>migration_step_log</tablename>
         <schemaname>etl_antam</schemaname>
         <connection>PG_TGT</connection>
         <name>Exists migration_step_log</name>
         <description />
         <type>TABLE_EXISTS</type>
         <attributes />
         <xloc>850</xloc>
         <yloc>60</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <tablename>migration_error_log</tablename>
         <schemaname>etl_antam</schemaname>
         <connection>PG_TGT</connection>
         <name>Exists migration_error_log</name>
         <description />
         <type>TABLE_EXISTS</type>
         <attributes />
         <xloc>1050</xloc>
         <yloc>60</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <add_rows_result>N</add_rows_result>
         <clear_result_rows>Y</clear_result_rows>
         <is_usevars>Y</is_usevars>
         <is_custom_sql>Y</is_custom_sql>
         <custom_sql>SELECT 1 WHERE etl_antam.fn_validate_config_selection('${CONFIG_ID}') &gt; 0</custom_sql>
         <connection>PG_TGT</connection>
         <tablename />
         <schemaname />
         <limit>1</limit>
         <success_condition>rows_count_equal</success_condition>
         <name>Validate CONFIG_ID</name>
         <description>Validasi wajib parameter CONFIG_ID</description>
         <type>EVAL_TABLE_CONTENT</type>
         <attributes />
         <xloc>1150</xloc>
         <yloc>60</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <filename>${PROJECT_HOME}/pipelines/pl_init_run.hpl</filename>
         <params_from_previous>N</params_from_previous>
         <exec_per_row>N</exec_per_row>
         <clear_rows>N</clear_rows>
         <clear_files>N</clear_files>
         <create_parent_folder>N</create_parent_folder>
         <set_logfile>N</set_logfile>
         <set_append_logfile>N</set_append_logfile>
         <logfile />
         <logext />
         <add_date>N</add_date>
         <add_time>N</add_time>
         <loglevel>Basic</loglevel>
         <wait_until_finished>Y</wait_until_finished>
         <parameters>
            <pass_all_parameters>Y</pass_all_parameters>
            <parameter>
               <name>MAIN_WORKFLOW</name>
               <stream_name/>
               <value>wf_main.hwf</value>
               <variable>wf_main.hwf</variable>
            </parameter>
            <parameter>
               <name>CONFIG_ID</name>
               <stream_name/>
               <value>${CONFIG_ID}</value>
               <variable>${CONFIG_ID}</variable>
            </parameter>
            <parameter>
               <name>CLIENT_CODE</name>
               <stream_name/>
               <value>${CLIENT_CODE}</value>
               <variable>${CLIENT_CODE}</variable>
            </parameter>
            <parameter>
               <name>ENV_CODE</name>
               <stream_name/>
               <value>${ENV_CODE}</value>
               <variable>${ENV_CODE}</variable>
            </parameter>
         </parameters>
         <run_configuration>local</run_configuration>
         <name>Init run</name>
         <description />
         <type>PIPELINE</type>
         <attributes />
         <xloc>1248</xloc>
         <yloc>48</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <filename>${PROJECT_HOME}/pipelines/pl_get_config.hpl</filename>
         <params_from_previous>N</params_from_previous>
         <exec_per_row>N</exec_per_row>
         <clear_rows>N</clear_rows>
         <clear_files>N</clear_files>
         <create_parent_folder>N</create_parent_folder>
         <set_logfile>N</set_logfile>
         <set_append_logfile>N</set_append_logfile>
         <logfile />
         <logext />
         <add_date>N</add_date>
         <add_time>N</add_time>
         <loglevel>Basic</loglevel>
         <wait_until_finished>Y</wait_until_finished>
         <parameters>
            <pass_all_parameters>Y</pass_all_parameters>
            <parameter>
               <name>CONFIG_ID</name>
               <stream_name/>
               <value>${CONFIG_ID}</value>
               <variable>${CONFIG_ID}</variable>
            </parameter>
         </parameters>
         <run_configuration>local</run_configuration>
         <name>Get config</name>
         <description />
         <type>PIPELINE</type>
         <attributes />
         <xloc>1250</xloc>
         <yloc>220</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <filename>${PROJECT_HOME}/workflows/wf_migrate_table.hwf</filename>
         <params_from_previous>N</params_from_previous>
         <exec_per_row>Y</exec_per_row>
         <set_logfile>N</set_logfile>
         <logfile />
         <logext />
         <add_date>N</add_date>
         <add_time>N</add_time>
         <loglevel>Basic</loglevel>
         <set_append_logfile>N</set_append_logfile>
         <create_parent_folder>N</create_parent_folder>
         <wait_until_finished>Y</wait_until_finished>
         <parameters>
            <pass_all_parameters>N</pass_all_parameters>
            <parameter>
               <name>CONFIG_ID</name>
               <value />
               <stream_name>config_id</stream_name>
            </parameter>
            <parameter>
               <name>SRC_SCHEMA</name>
               <value />
               <stream_name>src_schema</stream_name>
            </parameter>
            <parameter>
               <name>SRC_VIEW</name>
               <value />
               <stream_name>src_view</stream_name>
            </parameter>
            <parameter>
               <name>TGT_SCHEMA</name>
               <value />
               <stream_name>tgt_schema</stream_name>
            </parameter>
            <parameter>
               <name>TGT_TABLE</name>
               <value />
               <stream_name>tgt_table</stream_name>
            </parameter>
            <parameter>
               <name>STG_TABLE</name>
               <value />
               <stream_name>stg_table</stream_name>
            </parameter>
            <parameter>
               <name>SRC_PRECHECK_SQL</name>
               <value />
               <stream_name>src_precheck_sql</stream_name>
            </parameter>
         </parameters>
         <run_configuration>local</run_configuration>
         <name>Migrate each table</name>
         <description />
         <type>WORKFLOW</type>
         <attributes />
         <xloc>1040</xloc>
         <yloc>208</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <sql>CALL etl_antam.pr_finish_run(${RUN_ID})</sql>
         <connection>PG_TGT</connection>
         <useVariableSubstitution>Y</useVariableSubstitution>
         <sqlfromfile>N</sqlfromfile>
         <sqlfilename />
         <sendOneStatement>N</sendOneStatement>
         <name>Finish run</name>
         <description />
         <type>SQL</type>
         <attributes />
         <xloc>848</xloc>
         <yloc>208</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <name>Done</name>
         <description />
         <type>SUCCESS</type>
         <attributes />
         <xloc>450</xloc>
         <yloc>220</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <sql>UPDATE etl_antam.migration_run SET status = 'FAILED', end_time = now(), note = 'wf_main gagal, cek log Hop' WHERE run_id = ${RUN_ID}</sql>
         <connection>PG_TGT</connection>
         <useVariableSubstitution>Y</useVariableSubstitution>
         <sqlfromfile>N</sqlfromfile>
         <sqlfilename />
         <sqlfilename_encoding />
         <sendOneStatement>N</sendOneStatement>
         <name>Mark run failed</name>
         <description />
         <type>SQL</type>
         <attributes />
         <xloc>1040</xloc>
         <yloc>400</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <message>Pengecekan awal gagal: koneksi database atau tabel etl_antam tidak siap</message>
         <loglevel>Error</loglevel>
         <name>Abort (pre-run)</name>
         <description />
         <type>ABORT</type>
         <attributes />
         <xloc>450</xloc>
         <yloc>400</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
      <action>
         <message>Migrasi gagal, lihat etl_antam.migration_error_log</message>
         <loglevel>Error</loglevel>
         <name>Abort</name>
         <description />
         <type>ABORT</type>
         <attributes />
         <xloc>1040</xloc>
         <yloc>544</yloc>
         <parallel>N</parallel>
         <attributes_hac />
      </action>
  </actions>
  <hops>
      <hop>
         <from>Start</from>
         <to>Check DB connections</to>
         <evaluation>Y</evaluation>
         <unconditional>Y</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Check DB connections</from>
         <to>Exists migration_config</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Check DB connections</from>
         <to>Abort (pre-run)</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_config</from>
         <to>Exists migration_run</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_config</from>
         <to>Abort (pre-run)</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_run</from>
         <to>Exists migration_step_log</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_run</from>
         <to>Abort (pre-run)</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_step_log</from>
         <to>Exists migration_error_log</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_step_log</from>
         <to>Abort (pre-run)</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_error_log</from>
         <to>Validate CONFIG_ID</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Validate CONFIG_ID</from>
         <to>Init run</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Validate CONFIG_ID</from>
         <to>Abort (pre-run)</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Exists migration_error_log</from>
         <to>Abort (pre-run)</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Init run</from>
         <to>Get config</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Init run</from>
         <to>Abort (pre-run)</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Get config</from>
         <to>Migrate each table</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Get config</from>
         <to>Mark run failed</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Migrate each table</from>
         <to>Finish run</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Migrate each table</from>
         <to>Mark run failed</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Finish run</from>
         <to>Done</to>
         <evaluation>Y</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Finish run</from>
         <to>Mark run failed</to>
         <evaluation>N</evaluation>
         <unconditional>N</unconditional>
         <enabled>Y</enabled>
      </hop>
      <hop>
         <from>Mark run failed</from>
         <to>Abort</to>
         <evaluation>Y</evaluation>
         <unconditional>Y</unconditional>
         <enabled>Y</enabled>
      </hop>
  </hops>
  <notepads />
  <attributes>
      </attributes>
</workflow>